# TechTrainX Environment Configuration
# APP_URL: Base URL of the application
APP_URL="https://techtrainx.online"

# ADMIN ACCESS SECURITY
ADMIN_PASSWORD="your-strong-production-admin-passcode"
ADMIN_JWT_SECRET="your-cryptographic-random-jwt-secret-key"

# DATABASE_URL: MongoDB Atlas Connection String (Prisma / Mongoose Compatible)
# Example: mongodb+srv://username:password@cluster.mongodb.net/techtrainx_db?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/techtrainx_db?retryWrites=true&w=majority"
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/techtrainx_db?retryWrites=true&w=majority"




















# NODEMAILER / SMTP CONFIGURATION (Hostinger Mail Box: ttx@xnava.in | admission@xnava.in | info@xnava.in)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="ttx@xnava.in"
SMTP_PASS="your-hostinger-mailbox-password"
NOTIFICATION_EMAIL="ttx@xnava.in"

# WHATSAPP INTEGRATION
# Phone number in international format without + or spaces
WHATSAPP_PHONE="918545092070"

# IMAGEKIT CONFIGURATION FOR CDN & IMAGE STORAGE
IMAGEKIT_PUBLIC_KEY="public_your_imagekit_key"
IMAGEKIT_PRIVATE_KEY="private_your_imagekit_key"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/techtrainx"

# Vercel / Hostinger VM Environment Flags
NODE_ENV="development"
PORT=3000
